[servers]
monmon          ansible_host="{{ monmon_ip_address }}"

[servers:vars]
ansible_python_interpreter=/usr/bin/python3
ansible_user="{{ monmon_user | default('pi') }}"
ansible_password="{{ lookup('env', 'MONMON_PI_PASSWORD') }}"
ansible_become_password="{{ lookup('env', 'MONMON_PI_PASSWORD') }}"
