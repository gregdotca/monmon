[Unit]
Description=Delay before the first check.py run after boot
# Waits for the Pi's own Monit to get past its start delay and answer once the network is
# up, so the first check doesn't show it as down. Gives up after 60 seconds, so the checks
# still start if Monit isn't answering. Stays active afterwards, so only the first
# check.py run after a boot waits for it
Wants=network-online.target
After=network-online.target monit.service

[Service]
Type=oneshot
ExecStart=/bin/sh -c 'timeout 60 sh -c "until curl -s -o /dev/null --max-time 2 http://localhost:2812/; do sleep 1; done"; exit 0'
RemainAfterExit=yes
